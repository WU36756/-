# Copy to backend/.env and adjust. Never commit the real file.
APP_ACCESS_CODE=health-demo-2026

# mock | deepseek
APP_LLM_PROVIDER=mock
APP_MODEL=deepseek-flash
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
APP_DEEPSEEK_API_KEY=
APP_MAX_TOKENS=20000
APP_REASONING_EFFORT=low
APP_TIMEOUT_SECONDS=180

# Set true only after HTTPS is configured.
APP_COOKIE_SECURE=false
APP_DEMO_RESET_ENABLED=true
APP_ALLOW_PRIVATE_CUSTOM=false
APP_RATE_LIMIT_PER_MINUTE=60

# Optional: NCBI E-utilities etiquette.
APP_NCBI_TOOL=health-agent-platform
APP_NCBI_EMAIL=
APP_NCBI_API_KEY=
