# /etc/health-panel.env  (chmod 600 root:root)
# 只放服务器端配置；不要把 key 提交到 git

APP_LLM_PROVIDER=mock
APP_DEEPSEEK_API_KEY=
APP_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 自定义接口默认值（公开信息，不含 key；用户在页面上填自己的 key）
APP_CUSTOM_API_BASE=https://sshzyu.com/v1
APP_CUSTOM_API_MODEL=kimi-k2.6
APP_CUSTOM_API_KEY=

# 公网部署必须关闭演示数据重置，避免被人一键清空
APP_DEMO_RESET_ENABLED=false
# 默认禁止自定义接口访问内网/本机地址（SSRF 防护）
APP_ALLOW_PRIVATE_CUSTOM=false
# 每个 IP 每分钟最多 30 次分析请求
APP_RATE_LIMIT_PER_MINUTE=30

# 应用登录：每个浏览器输入一次访问码，数据按浏览器隔离
APP_ACCESS_CODE=change-me-to-a-long-code
# 自动生成并保存在 data/.session-secret；也可显式设置
APP_SECRET_KEY=
# 通过 HTTPS 访问时设为 true（本地 http 调试用 false）
APP_COOKIE_SECURE=true

PYTHONDONTWRITEBYTECODE=1
TZ=Asia/Shanghai
