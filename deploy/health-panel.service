[Unit]
Description=Health Agent Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=health
Group=health
Environment=PYTHONDONTWRITEBYTECODE=1
WorkingDirectory=/opt/health-agent/backend
EnvironmentFile=/etc/health-panel.env
ExecStart=/opt/health-agent/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100 --workers 1
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/health-agent/backend/data /opt/health-agent/backend/out
ProtectHome=true
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
